# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# AI Foundry portal → your project → Overview → Project endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<hub-name>.services.ai.azure.com/api/projects/<project-name>

# AI Foundry portal → your project → Settings → Keys
FOUNDRY_MODEL_API_KEY=<your-foundry-api-key>

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Azure portal → your Search service → Overview → Url
SEARCH_SERVICE_URL=https://<search-service-name>.search.windows.net

# Azure portal → your Search service → Settings → Keys → Primary admin key
SEARCH_SERVICE_API_KEY=<your-search-api-key>

# ── Azure Blob Storage ────────────────────────────────────────────────────────
STORAGE_ACCOUNT_NAME=<your-storage-account>
STORAGE_CONTAINER_NAME=docs-pdf
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

# ── Models ────────────────────────────────────────────────────────────────────
LLM_MODEL_NAME=gpt-4.1
EMBEDDING_MODEL_NAME=text-embedding-3-small

# ── Azure SQL ─────────────────────────────────────────────────────────────────
SQL_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Database=<db>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
